// Template helper for signed integer types
template <typename IntType,
          std::enable_if_t<
              std::conjunction_v<std::is_integral<IntType>,
                                 std::is_signed<IntType>>,
              bool> = true>
static bool fromJsonValueIntegral(IntType &value, const QJsonValue &jval)
{
    if (!jval.isDouble())
        return false;

    const qint64 intVal = jval.toInteger();
    // Roundtrip to catch actual 0 value
    if (static_cast<double>(intVal) != jval.toDouble())
        return false;

    // Range check
    if (intVal < std::numeric_limits<IntType>::min()
        || intVal > std::numeric_limits<IntType>::max()) {
        return false;
    }

    value = static_cast<IntType>(intVal);
    return true;
}

